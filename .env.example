# Cloudflare Pages / React Frontend Environment Variables
# The frontend requires ONLY the Google Apps Script Web App execution URL
VITE_APPS_SCRIPT_URL=

# Note: The following are NOT frontend variables and must NEVER be in .env!
# Configure these securely in Google Apps Script > Project Settings > Script Properties:
# - CNE_SPREADSHEET_ID
# - DROPDOWN_SPREADSHEET_ID
# - DRIVE_FOLDER_ID
# - SESSION_SECRET
# - PASSWORD_PEPPER
# - GEMINI_API_KEY
# - GEMINI_MODEL (e.g. gemini-2.5-flash)