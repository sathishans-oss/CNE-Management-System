{
  "name": "cne-management-system",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "build:server": "esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node server.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "sync": "node scripts/sync-apps-script.js",
    "sync:gas": "node scripts/sync-apps-script.js",
    "test": "node scripts/verify-all.js",
    "verify": "node scripts/verify-all.js",
    "verify:all": "node scripts/verify-all.js",
    "verify:security": "node scripts/verify-all.js --suite security",
    "verify:workflows": "node scripts/verify-all.js --suite workflows",
    "verify:pdf": "node scripts/verify-all.js --suite pdf",
    "verify:integration": "node scripts/verify-all.js --suite integration",
    "verify:delete": "node scripts/verify-all.js --suite delete",
    "verify:interest": "node scripts/verify-all.js --suite interest",
    "verify:performance": "node scripts/verify-all.js --suite performance",
    "verify:timezone": "node scripts/verify-timezone-cross-module.cjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "express": "^5.2.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^0.546.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.14.0",
    "@types/qrcode": "^1.5.6",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}